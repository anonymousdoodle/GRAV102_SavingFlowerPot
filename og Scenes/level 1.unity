MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1721176387}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b245ebb3058b574fb89df48854446a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 915655085}
  nameText: {fileID: 1127411019}
  faceImage: {fileID: 981316762}
  dialogueText: {fileID: 80555543}
  dialogueLines:
  - speakerName: Mrs. Snickers
    faceSprite: {fileID: 21300000, guid: 4c49de616ed17ff41a7fd7a4165c7b06, type: 3}
    dialogueText: Good day dearie!
  - speakerName: May
    faceSprite: {fileID: 21300000, guid: 0d047646cec2ce542bb3d2f045d670db, type: 3}
    dialogueText: Good day to you, Mrs. Snickers!!
  - speakerName: Mrs. Snickers
    faceSprite: {fileID: 21300000, guid: 87e892a5f3808944d858c434d255d20e, type: 3}
    dialogueText: Pardon me, dearie, I'm starting to lose my memory...
  - speakerName: Mrs. Snickers
    faceSprite: {fileID: 21300000, guid: 87e892a5f3808944d858c434d255d20e, type: 3}
    dialogueText: I just bought a plant from the plant store, and I have to put it
      in my plant collection!
  - speakerName: May
    faceSprite: {fileID: 21300000, guid: c87fed51f2a988945a8f96412c31945f, type: 3}
    dialogueText: Oh, I don't know about that ma'am...
  - speakerName: May
    faceSprite: {fileID: 21300000, guid: d7e3d9e9e620ca646aa780d6d07b9751, type: 3}
    dialogueText: ... You could try to visit each building in town, maybe that will
      jog your memory!
  - speakerName: Mrs. Snickers
    faceSprite: {fileID: 21300000, guid: 4c49de616ed17ff41a7fd7a4165c7b06, type: 3}
    dialogueText: Thank you dearie. I'll be off now.
  - speakerName: May
    faceSprite: {fileID: 21300000, guid: c87fed51f2a988945a8f96412c31945f, type: 3}
    dialogueText: ....
  - speakerName: May
    faceSprite: {fileID: 21300000, guid: 0d047646cec2ce542bb3d2f045d670db, type: 3}
    dialogueText: .... can i still have your plant?
  - speakerName: Mrs. Snickers
    faceSprite: {fileID: 21300000, guid: c6cf0d7b9ac7c6649bd9b9bc711715a6, type: 3}
    dialogueText: No.
  - speakerName: May
    faceSprite: {fileID: 21300000, guid: 8d494366c966dde4ebfce19e6d13e06a, type: 3}
    dialogueText: Awww....
  repeatedLines:
  - speakerName: May
    faceSprite: {fileID: 21300000, guid: c87fed51f2a988945a8f96412c31945f, type: 3}
    dialogueText: Be careful out there, ma'am! There's plant fanatics everywhere!
  playerMovement: {fileID: 123139260}
  npcArrow: {fileID: 1631935732}
